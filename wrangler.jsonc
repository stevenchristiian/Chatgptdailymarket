{
  "name": "chatgptdailymarket",
  "compatibility_date": "2026-10-15",
  "build": {
    "command": "python3 dashboard/build.py"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "dashboard/worker.mjs"
}
